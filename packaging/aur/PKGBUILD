# Maintainer: re2zero
#
# Source of truth for the AUR `hopdeck` package. The aur-publish.yml
# workflow copies this file, pins pkgver/pkgrel to the release,
# refreshes sha256sums with updpkgsums, regenerates .SRCINFO, and
# pushes to the AUR. Edit depends / package() etc. here — never in the
# AUR repo directly.
pkgname=hopdeck
pkgver=0.11.0
pkgrel=1
pkgdesc='Software KVM Switch / mouse & keyboard sharing software for Local Area Networks'
arch=('x86_64')
url='https://github.com/re2zero/hopdeck'
license=('GPL-3.0-or-later')
depends=('libx11' 'libxtst' 'wayland' 'libxkbcommon' 'glibc' 'gcc-libs' 'hicolor-icon-theme')
makedepends=('rust')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('0b32a794db47db21c973e456826467e8fec490e007e1b20eb0fa78ee6a339241')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
  cargo build --frozen --release -p hopdeck-console
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/hopdeck "$pkgdir/usr/bin/hopdeck"
  install -Dm755 target/release/hopdeck-console "$pkgdir/usr/bin/hopdeck-console"
  install -Dm644 apps/hopdeck/com.hopdeck.HopDeck.desktop "$pkgdir/usr/share/applications/com.hopdeck.HopDeck.desktop"
  install -Dm644 apps/hopdeck/assets/com.hopdeck.HopDeck.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.hopdeck.HopDeck.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
