# Maintainer: re2zero
#
# Source of truth for the AUR `hopdeck-git` package — tracks main.
# The pkgver() function regenerates the version from `git describe`
# at build time; the static pkgver= line below is metadata only (for
# AUR display). aur-publish.yml bumps that line on each release.
pkgname=hopdeck-git
_pkgname=hopdeck
pkgver=0.11.2.r0.gabcdef
pkgrel=1
pkgdesc='Software KVM Switch / mouse & keyboard sharing software for Local Area Networks (latest main)'
arch=('x86_64' 'aarch64')
url='https://github.com/re2zero/hopdeck'
license=('GPL-3.0-or-later')
depends=('libx11' 'libxtst' 'wayland' 'libxkbcommon' 'glibc' 'gcc-libs' 'hicolor-icon-theme')
makedepends=('rust' 'git')
options=('!lto')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname" "$_pkgname-bin")
source=("$_pkgname::git+https://github.com/re2zero/$_pkgname.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  # <last-tag>.r<commits-since>.g<short-hash> — sortable + uniquely
  # identifies the commit. Strip the `v` prefix; rewrite the
  # `-N-g<sha>` git-describe suffix to `.rN.g<sha>` for pacman.
  git describe --long --tags --abbrev=7 \
    | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
  cargo build --frozen --release -p hopdeck-console
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/hopdeck "$pkgdir/usr/bin/hopdeck"
  install -Dm755 target/release/hopdeck-console "$pkgdir/usr/bin/hopdeck-console"
  install -Dm644 apps/hopdeck/hopdeck.desktop \
    "$pkgdir/usr/share/applications/hopdeck.desktop"
  install -Dm644 apps/hopdeck/assets/hopdeck.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/hopdeck.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
